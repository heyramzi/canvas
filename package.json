{
  "name": "@heyramzi/canvas",
  "version": "0.1.0",
  "description": "A Svelte 5 canvas on xyflow with a hand-drawing pen, a plugin API for custom cards and ops, and headless ops for servers and CLIs.",
  "keywords": [
    "svelte",
    "sveltekit",
    "svelte5",
    "xyflow",
    "svelte-flow",
    "canvas",
    "whiteboard",
    "diagram",
    "freehand",
    "pen",
    "plugin"
  ],
  "license": "MIT",
  "author": {
    "name": "Ramzi",
    "url": "https://github.com/heyramzi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyramzi/canvas.git"
  },
  "homepage": "https://github.com/heyramzi/canvas#readme",
  "bugs": {
    "url": "https://github.com/heyramzi/canvas/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test-utils.*"
  ],
  "imports": {
    "#src/*.js": "./src/lib/*.ts",
    "#src/*": "./src/lib/*",
    "#kit.config.js": "./kit.config.js"
  },
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./*.svelte": {
      "types": "./src/lib/*.svelte",
      "svelte": "./src/lib/*.svelte",
      "default": "./src/lib/*.svelte"
    },
    "./*.css": "./src/lib/*.css",
    "./*.js": {
      "types": "./src/lib/*.ts",
      "svelte": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./*.svelte": {
        "types": "./dist/*.svelte.d.ts",
        "svelte": "./dist/*.svelte",
        "default": "./dist/*.svelte"
      },
      "./*.css": "./dist/*.css",
      "./*.js": {
        "types": "./dist/*.d.ts",
        "svelte": "./dist/*.js",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "package": "svelte-kit sync && svelte-package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vp test run -c vite.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@xyflow/svelte": "^1.7.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "26.6.4",
    "@xyflow/svelte": "^1.7.0",
    "jsdom": "^30.1.2",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.3"
  }
}
